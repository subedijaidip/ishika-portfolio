---
import BigLogo from "@/components/assets/BigLogo.astro";
---

<section class="overflow-hidden relative">
  <BigLogo class="lg:-mx-4 opacity-4 absolute inset-0" />
  <div class="py-12 max-w-xl mx-auto px-8 relative">
    <div>
      <span
        class="inline-flex items-center justify-center gap-2 rounded-full px-3 h-7.5 text-xs text-base-900 bg-white ring-inset"
      >
        <p>4 Spots Available for 2026</p>
        <div class="size-2 rounded-full bg-black border-2 border-black"></div>
        <div class="size-2 rounded-full border-black border-2"></div>
      </span>
      <h1 class="text-4xl mt-12 tracking-tight text-base-900 text-balance font-medium">
        Thoughtful interior design for modern homes.
      </h1>
    </div>
    <div
      class="grid grid-cols-1 text-base text-base-600 lg:grid-cols-2 max-w-xl gap-2 group h-full mt-12"
    >
      <p>
        Ishika streamlines the interior design process with curated design solutions for spaces.
      </p>
      <p>
        From concept to completion, no-obligation, get started today and see your space transform.
      </p>
      
    </div>
    <p class="text-sm italic text-base-600 mt-8">
      Embrace flexibility in the interior design. <span class="block text-base-900">⏤ Get started today.</span>
    </p>
  </div>
</section>