---
const services = [
  {
    category: "Design Services",
    items: [
      "Residential Interior Design Consultation",
      "Space Planning & Floor Layouts",
      "Color Psychology & Mood Boards",
      "Furniture & Fixture Selection",
      "3D Visualization & Renderings",
      "Project Management & Styling",
      "Virtual Design Consultations",
    ],
  },
  {
    category: "Development Services",
    items: [
      "On-Site Project Supervision",
      "Vendor Coordination & Procurement",
      "Quality Assurance & Inspections",
      "Timeline & Budget Management",
      "Design Implementation Support",
      "Client Communication & Updates",
      "Post-Project Styling & Refinement",
    ],
  },
];
---

<section>
  <div class="px-8 py-12 max-w-xl mx-auto">
    <h2 class="text-4xl tracking-tight text-base-900 text-balance font-medium">
      Services
    </h2>

    <div class="flex flex-col gap-px mt-4">
      {
        services.map(({ category, items }) => (
          <div class="bg-white p-8 rounded-3xl">
            <h3
              id={`${category.toLowerCase()}-heading`}
              class="text-xl text-base-900"
            >
              {category}
            </h3>

            <ul
              role="list"
              class="grid grid-cols-1 lg:grid-cols-2 gap-y-1 gap-x-4 mt-2 list-disc pl-4"
            >
              {items.map((title) => (
                <li class="text-sm text-base-600">{title}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
