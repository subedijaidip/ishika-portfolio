---
const services = [
  {
    category: "Design Services",
    items: [
      "Residential Consultations",
      "Space Planning",
      "Color Psychology",
      "Mood Boards",
      "Furniture Selection",
      "3D Renderings",
      "Virtual Consultations",
      "Design Concepts",
    ],
  },
  {
    category: "Development Services",
    items: [
      "On-Site Supervision",
      "Vendor Coordination",
      "Quality Assurance",
      "Timeline Management",
      "Implementation Support",
      "Client Communication",
      "Styling Refinement",
      "Project Completion",
    ],
  },
];
---

<section>
  <div class="px-8 py-12 max-w-xl mx-auto">
    <h2 class="text-4xl tracking-tight text-base-900 text-balance font-medium">
      Services
    </h2>

    <div class="flex flex-col gap-px mt-4">
      {
        services.map(({ category, items }) => (
          <div class="bg-white p-8 rounded-3xl">
            <h3
              id={`${category.toLowerCase()}-heading`}
              class="text-xl text-base-900"
            >
              {category}
            </h3>

            <ul
              role="list"
              class="grid grid-cols-1 lg:grid-cols-2 gap-y-1 gap-x-4 mt-2 list-disc pl-4"
            >
              {items.map((title) => (
                <li class="text-sm text-base-600">{title}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
